#!/bin/bash
#PBS -N hopf_se3
#PBS -P hpc.dtu.kavinder
#PBS -q scai_q
#PBS -l select=1:ncpus=16:ngpus=1
#PBS -l walltime=12:00:00
#PBS -o /scratch/hpc/visitor/dtu001.visitor/SPACE-HOP/logs/hopf_se3.out
#PBS -e /scratch/hpc/visitor/dtu001.visitor/SPACE-HOP/logs/hopf_se3.err
# Continues the SE(3) Hopf-fibration refiner (src/hopf_se3.py) from the workstation checkpoint, then evaluates
# it on val and test starting from cached SPACE-HOP predictions.
ROOT=/scratch/hpc/visitor/dtu001.visitor/SPACE-HOP
PY=/home/hpc/visitor/dtu001.visitor/le-wm/.venv/bin/python
RUN=$ROOT/checkpoints/hopf_se3_fixed
cd $ROOT
export XDG_CACHE_HOME=$ROOT/cache HF_HUB_OFFLINE=1 OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 PYTHONUNBUFFERED=1
echo "=== $(date) job $PBS_JOBID on $(hostname)"
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv
# resume from the newest checkpoint: the workstation one first, then whatever this job wrote last
[ -f $RUN/last.pth ] && RESUME="--resume $RUN/last.pth"
$PY src/hopf_se3.py train --config configs/isro_hpc.yaml --out $RUN --img_size 224 --bs 16 --epochs 15 \
    --min_scale 1.0 --probe_scale 1.0 --probe_every 500 --num_workers 14 $RESUME >> $RUN/train_hpc.log 2>&1
for split in val test; do
  $PY src/hopf_se3.py eval --config configs/isro_hpc.yaml --ckpt $RUN/last.pth --img_size 224 --split $split \
      --n_eval 5000 --iters 4 --k_refs 1 4 >> $RUN/eval_hpc.log 2>&1
done
echo "=== $(date) HOPF_SE3_DONE"
