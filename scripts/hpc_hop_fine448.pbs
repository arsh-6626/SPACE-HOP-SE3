#!/bin/bash
#PBS -N hop_fine448
#PBS -P hpc.dtu.kavinder
#PBS -q scai_q
#PBS -l select=1:ncpus=8:ngpus=1
#PBS -l walltime=24:00:00
#PBS -o /scratch/hpc/visitor/dtu001.visitor/SPACE-HOP/logs/hop_fine448.out
#PBS -e /scratch/hpc/visitor/dtu001.visitor/SPACE-HOP/logs/hop_fine448.err
# Items 2+3: fine refiner at 448 px, initialised from the finished 224 px coarse refiner (pos_embed regenerated).
ROOT=/scratch/hpc/visitor/dtu001.visitor/SPACE-HOP
PY=/home/hpc/visitor/dtu001.visitor/le-wm/.venv/bin/python
C=$ROOT/checkpoints
cd $ROOT
export XDG_CACHE_HOME=$ROOT/cache HF_HOME=$ROOT/cache/huggingface HF_HUB_OFFLINE=1 \
       OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1 PYTORCH_ALLOC_CONF=expandable_segments:True
H="$PY src/hopf_se3.py"
CFG="--config configs/isro_hpc.yaml"
FINE="--min_scale 1.0 --probe_scale 1.0 --rot_deg 0.5 --lat 0.003 --depth 0.002"
set -x
echo "=== $(date) job $PBS_JOBID on $(hostname)"

mkdir -p $C/hopf_fine448/stage1
# refined val poses of the current coarse refiner: what the fine stage is monitored from
$H eval $CFG --split val --n_eval 5000 --k_refs 4 --init_dir $C/hopf_se3_fixed --out $C/hopf_fine448/stage1 \
    --stages $C/hopf_se3_fixed/last.pth:4 > $C/hopf_fine448/stage1.log 2>&1
$H train $CFG --out $C/hopf_fine448 --init_dir $C/hopf_fine448/stage1 --init $C/hopf_se3_fixed/last.pth --img_size 448 \
    --bs 16 --epochs 20 --lr 5e-5 $FINE --probe_every 1000 --num_workers 7 > $C/hopf_fine448/train.log 2>&1
echo "=== $(date) HOP_FINE448_DONE"
