#!/bin/bash
#PBS -N isro_all
#PBS -P hpc.dtu.kavinder
#PBS -q scai_q
#PBS -l select=1:ncpus=24:ngpus=2
#PBS -l walltime=24:00:00
#PBS -o /scratch/hpc/visitor/dtu001.visitor/SPACE-HOP/logs/isro_all.out
#PBS -e /scratch/hpc/visitor/dtu001.visitor/SPACE-HOP/logs/isro_all.err
# Three runs moved from the workstation, each resuming from its last checkpoint:
#   GPU A: SPACE-HOP 448 px, JEPA backbone      (configs/isro_448_hpc.yaml)
#          + SE(3) Hopf-fibration refiner        (src/hopf_se3.py, small: ~4 GB)
#   GPU B: SPACE-HOP 448 px, DINOv3 ViT-B/16     (configs/isro_448_dinov3_hpc.yaml)
# then evaluates every model on val + test.
ROOT=/scratch/hpc/visitor/dtu001.visitor/SPACE-HOP
PY=/home/hpc/visitor/dtu001.visitor/le-wm/.venv/bin/python
HOPF=$ROOT/checkpoints/hopf_se3_fixed
cd $ROOT
export XDG_CACHE_HOME=$ROOT/cache HF_HOME=$ROOT/cache/huggingface HF_HUB_OFFLINE=1 \
       OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 PYTHONUNBUFFERED=1 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
echo "=== $(date) job $PBS_JOBID on $(hostname) CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
nvidia-smi --query-gpu=index,name,driver_version,memory.total --format=csv
GPUS=(${CUDA_VISIBLE_DEVICES//,/ }); GA=${GPUS[0]}; GB=${GPUS[1]:-${GPUS[0]}}

CUDA_VISIBLE_DEVICES=$GA $PY src/train.py --config configs/isro_448_hpc.yaml \
    >> checkpoints/pose_isro_448/train_hpc.log 2>&1 &
P1=$!
CUDA_VISIBLE_DEVICES=$GB $PY src/train.py --config configs/isro_448_dinov3_hpc.yaml \
    >> checkpoints/pose_isro_448_dinov3/train_hpc.log 2>&1 &
P2=$!
( CUDA_VISIBLE_DEVICES=$GA $PY src/hopf_se3.py train --config configs/isro_hpc.yaml --out $HOPF --img_size 224 \
      --bs 16 --epochs 15 --min_scale 1.0 --probe_scale 1.0 --probe_every 500 --num_workers 6 \
      --resume $HOPF/last.pth >> $HOPF/train_hpc.log 2>&1
  for split in val test; do
    CUDA_VISIBLE_DEVICES=$GA $PY src/hopf_se3.py eval --config configs/isro_hpc.yaml --ckpt $HOPF/last.pth \
        --img_size 224 --split $split --n_eval 5000 --iters 4 --k_refs 1 4 >> $HOPF/eval_hpc.log 2>&1
  done ) &
P3=$!
echo "launched jepa448=$P1 dinov3_448=$P2 hopf_se3=$P3"
wait $P1; echo "$(date) jepa448 exited $?"
CUDA_VISIBLE_DEVICES=$GA $PY src/val.py --config configs/isro_448_hpc.yaml \
    --checkpoint checkpoints/pose_isro_448/best_model.pth --splits val test >> checkpoints/pose_isro_448/eval_hpc.log 2>&1 &
wait $P2; echo "$(date) dinov3_448 exited $?"
CUDA_VISIBLE_DEVICES=$GB $PY src/val.py --config configs/isro_448_dinov3_hpc.yaml \
    --checkpoint checkpoints/pose_isro_448_dinov3/best_model.pth --splits val test >> checkpoints/pose_isro_448_dinov3/eval_hpc.log 2>&1 &
wait
echo "=== $(date) ISRO_ALL_DONE"
